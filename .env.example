# Copia este archivo como .env y ajusta los valores.
# Next.js, Drizzle, los scripts y Docker Compose leen el mismo .env.

# --- Postgres local (docker-compose.yml) ---
POSTGRES_USER=perindio
POSTGRES_PASSWORD=perindio
POSTGRES_DB=perindio
POSTGRES_PORT=5432

# --- Conexión de la app ---
# Local: apunta al contenedor de arriba.
# Nube (Supabase, Neon, etc.): cadena de conexión del pooler en modo transacción.
DATABASE_URL=postgres://perindio:perindio@localhost:5432/perindio

# --- Autenticación (Better Auth) ---
# Secreto para firmar sesiones. Genera uno propio con: openssl rand -base64 32
# En la nube usa uno distinto al de desarrollo.
BETTER_AUTH_SECRET=cambia-este-secreto-por-uno-generado
# URL pública de la app (en la nube, el dominio real, por ejemplo https://rifas.ejemplo.com).
BETTER_AUTH_URL=http://localhost:3000

# --- Usuario administrador que crea pnpm db:seed (solo desarrollo) ---
SEED_ADMIN_NOMBRE=Administrador demo
SEED_ADMIN_EMAIL=admin@perindio.test
SEED_ADMIN_PASSWORD=demo-perindio-2026

# --- Pruebas (pnpm test) ---
# Base aparte que las pruebas vacían y vuelven a llenar. Debe ser local y terminar en _test;
# se crea sola en el mismo contenedor.
TEST_DATABASE_URL=postgres://perindio:perindio@localhost:5432/perindio_test
